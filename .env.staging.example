POSTGRES_USER=tchuno
POSTGRES_PASSWORD=tchuno
POSTGRES_DB=tchuno
POSTGRES_PORT=5433

DATABASE_URL="postgresql://tchuno:REPLACE_WITH_STAGING_DB_PASSWORD@localhost:5433/tchuno?schema=public"
JWT_ACCESS_SECRET="REPLACE_WITH_STAGING_ACCESS_SECRET_AT_LEAST_32_CHARS"
JWT_REFRESH_SECRET="REPLACE_WITH_STAGING_REFRESH_SECRET_AT_LEAST_32_CHARS"
API_PORT=3001
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
NODE_ENV=staging

# Payments (foundation + external-ready)
PAYMENT_DEFAULT_PROVIDER=INTERNAL
PAYMENT_WEBHOOK_SECRET="REPLACE_WITH_STAGING_WEBHOOK_SECRET_AT_LEAST_32_CHARS"
PAYMENT_WEBHOOK_SECRET_MPESA="REPLACE_WITH_STAGING_MPESA_WEBHOOK_SECRET_AT_LEAST_32_CHARS"
PAYMENT_WEBHOOK_SECRET_EMOLA="REPLACE_WITH_STAGING_EMOLA_WEBHOOK_SECRET_AT_LEAST_32_CHARS"
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_WEBHOOK_FUTURE_SKEW_SECONDS=60
PAYMENT_RECONCILE_PROVIDERS="MPESA,EMOLA"
PAYMENT_RECONCILE_BATCH_SIZE=50
PAYMENT_RECONCILE_MIN_AGE_MINUTES=1
PAYMENT_AUTO_RECONCILIATION_ENABLED=true
PAYMENT_AUTO_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_GATEWAY_SETTLEMENT_DELAY_MS=30000
